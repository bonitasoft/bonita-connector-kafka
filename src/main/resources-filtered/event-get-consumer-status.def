<?xml version="1.0" encoding="UTF-8"?>
<definition:ConnectorDefinition
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:definition="http://www.bonitasoft.org/ns/connector/definition/6.1">

  <id>${event-get-consumer-status.def.id}</id>
  <version>${event-get-consumer-status.def.version}</version>
  <icon>kafka.png</icon>
  <category icon="kafka.png" id="Kafka/RabbitMQ"/>

  <input name="brokerType" type="java.lang.String" mandatory="true"/>
  <input name="bootstrapServers" type="java.lang.String" mandatory="true"/>
  <input name="securityProtocol" type="java.lang.String" mandatory="false" defaultValue="PLAINTEXT"/>
  <input name="saslMechanism" type="java.lang.String" mandatory="false"/>
  <input name="saslUsername" type="java.lang.String" mandatory="false"/>
  <input name="saslPassword" type="java.lang.String" mandatory="false"/>
  <input name="rabbitmqUsername" type="java.lang.String" mandatory="false"/>
  <input name="rabbitmqPassword" type="java.lang.String" mandatory="false"/>
  <input name="rabbitmqVirtualHost" type="java.lang.String" mandatory="false" defaultValue="/"/>
  <input name="rabbitmqSsl" type="java.lang.Boolean" mandatory="false" defaultValue="false"/>
  <input name="topicOrQueue" type="java.lang.String" mandatory="true"/>
  <input name="consumerGroup" type="java.lang.String" mandatory="false"/>
  <input name="timeoutSeconds" type="java.lang.Integer" mandatory="false" defaultValue="30"/>
  <input name="maxRetries" type="java.lang.Integer" mandatory="false" defaultValue="3"/>

  <output name="success" type="java.lang.Boolean"/>
  <output name="errorMessage" type="java.lang.String"/>
  <output name="brokerTypeOut" type="java.lang.String"/>
  <output name="source" type="java.lang.String"/>
  <output name="consumerGroupOut" type="java.lang.String"/>
  <output name="lagOrDepth" type="java.lang.Long"/>
  <output name="partitionsOrConsumers" type="java.lang.Integer"/>
  <output name="connected" type="java.lang.Boolean"/>

  <page id="connectionPage">
    <widget xsi:type="definition:Text" id="brokerTypeWidget" inputName="brokerType"/>
    <widget xsi:type="definition:Text" id="bootstrapServersWidget" inputName="bootstrapServers"/>
    <widget xsi:type="definition:Text" id="securityProtocolWidget" inputName="securityProtocol"/>
    <widget xsi:type="definition:Text" id="saslMechanismWidget" inputName="saslMechanism"/>
    <widget xsi:type="definition:Text" id="saslUsernameWidget" inputName="saslUsername"/>
    <widget xsi:type="definition:Password" id="saslPasswordWidget" inputName="saslPassword"/>
    <widget xsi:type="definition:Text" id="rabbitmqUsernameWidget" inputName="rabbitmqUsername"/>
    <widget xsi:type="definition:Password" id="rabbitmqPasswordWidget" inputName="rabbitmqPassword"/>
    <widget xsi:type="definition:Text" id="rabbitmqVirtualHostWidget" inputName="rabbitmqVirtualHost"/>
    <widget xsi:type="definition:Checkbox" id="rabbitmqSslWidget" inputName="rabbitmqSsl"/>
  </page>
  <page id="operationPage">
    <widget xsi:type="definition:Text" id="topicOrQueueWidget" inputName="topicOrQueue"/>
    <widget xsi:type="definition:Text" id="consumerGroupWidget" inputName="consumerGroup"/>
  </page>
  <page id="advancedPage">
    <widget xsi:type="definition:Text" id="timeoutSecondsWidget" inputName="timeoutSeconds"/>
    <widget xsi:type="definition:Text" id="maxRetriesWidget" inputName="maxRetries"/>
  </page>
</definition:ConnectorDefinition>
